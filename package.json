{
  "name": "fixloop",
  "private": true,
  "version": "1.0.0",
  "description": "FixLoop: QR-first campus maintenance loop. Scan it. Report it. Track it. Verify the fix.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">= 20.20.0",
    "npm": ">= 10.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p amplify/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandbox": "ampx sandbox",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "~6.15.7",
    "aws-amplify": "~6.22.2",
    "lucide-react": "~1.74.0",
    "qr-scanner": "~1.4.2",
    "qrcode": "~1.5.4",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-router-dom": "~7.18.5"
  },
  "devDependencies": {
    "@aws-amplify/backend": "~1.25.1",
    "@aws-amplify/backend-cli": "~1.10.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1170.0",
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/types": "^3.975.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "~4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/qrcode": "~1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~5.1.2",
    "aws-cdk-lib": "~2.277.0",
    "constructs": "~10.8.1",
    "esbuild": "^0.27.7",
    "jsdom": "^31.0.1",
    "tailwindcss": "~4.3.5",
    "tsx": "~4.23.15",
    "typescript": "~5.9.3",
    "vite": "~7.3.8",
    "vitest": "~4.1.12"
  }
}
