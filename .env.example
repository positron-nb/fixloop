# FixLoop has NO secrets in source code. The web app reads its backend endpoints from
# amplify_outputs.json, which `npx ampx sandbox` (local) or Amplify Hosting (production)
# generates. That file holds only public identifiers (pool IDs, API URL).
#
# The variables below are only for the helper scripts in scripts/ and for the AWS SDK.
# Copy to .env (never commit .env) or export them in your shell.

# Named AWS profile created with `npx ampx configure profile` (IAM user access key).
AWS_PROFILE=fixloop
AWS_REGION=ap-south-1

# scripts/smoke.mjs: the deployed URL to test, e.g. https://main.d1abcdef.amplifyapp.com
SMOKE_URL=

# scripts/bootstrap-admin.mjs: the first administrator's email
ADMIN_EMAIL=
